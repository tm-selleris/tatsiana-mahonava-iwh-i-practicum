doctype html
html
	head
		title= title
		meta(name="viewport" content="width=device-width, initial-scale=1")
		link(rel="stylesheet" href="/css/style.css")
	body
		main.page
			h1 Custom Object Table
			p.add-link
				a(href="/update-cobj") Add to this table

			if data.length
				.table-wrapper
					table
						thead
							tr
								th(scope="col") Name
								th(scope="col") Publisher
								th(scope="col") Price
						tbody
							each record in data
								tr
									td= record.properties.name || '—'
									td= record.properties.publisher || '—'
									td= record.properties.price ? `${record.properties.price} USD` : '—'
			else
				p.empty-state No video games have been added yet.
